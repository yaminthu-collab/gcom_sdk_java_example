THARABA_GATE_API_KEY=replace-with-test-key
THARABA_GATE_WEBHOOK_SECRET=replace-with-webhook-secret
THARABA_GATE_ENVIRONMENT=TEST
# Obtain the verified TEST API root from Tharaba Gate.
THARABA_GATE_BASE_URL=http://localhost:9090
# Confirm the bank's expiry wall-clock timezone with the gateway.
THARABA_GATE_QR_ZONE=Asia/Rangoon
MERCHANT_PUBLIC_URL=http://localhost:8080
